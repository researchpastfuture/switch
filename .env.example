# Switch — environment template. Copy to .env and fill in what you need.

# Anthropic API key. Switch uses your existing `claude` CLI auth by default;
# only set this if you want Switch agents to authenticate with a different key
# than your interactive Claude Code session.
# ANTHROPIC_API_KEY=

# Vercel token for auto preview-deploy lookup (optional — Switch falls back to
# the `vercel` CLI's local auth if this is unset).
# VERCEL_TOKEN=
