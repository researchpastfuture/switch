#!/bin/sh
# Switch recovery — picks up tasks that were stuck in 'running' because the
# orchestrator crashed mid-fleet. For each, commits the worktree, parses cost
# from the log, and marks the task awaiting_approval (or no_changes if empty).
SWITCH_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
exec "$SWITCH_ROOT/.venv/bin/python" - "$@" <<'PY'
import json, sqlite3, subprocess, sys
from datetime import datetime, timezone
from pathlib import Path

SWITCH = Path.home() / "switch"
STATE_DB = SWITCH / "state" / "tasks.sqlite"
LOGS_DIR = SWITCH / "state" / "logs"

def parse_cost(log_path: Path):
    cost, tin, tout = 0.0, 0, 0
    if not log_path.exists():
        return cost, tin, tout
    try:
        for line in log_path.read_text(errors="replace").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                e = json.loads(line)
            except Exception:
                continue
            if isinstance(e, dict) and e.get("type") == "result":
                cost = float(e.get("total_cost_usd", cost) or cost)
                u = e.get("usage") or {}
                tin = int(u.get("input_tokens", tin) or tin)
                tout = int(u.get("output_tokens", tout) or tout)
    except Exception as e:
        print(f"  ! parse error on {log_path.name}: {e}")
    return cost, tin, tout

conn = sqlite3.connect(STATE_DB)
stuck = list(conn.execute("SELECT id, product, branch, worktree_path FROM tasks WHERE status='running'"))
conn.close()
if not stuck:
    print("Nothing stuck in 'running'. Nothing to recover.")
    sys.exit(0)

print(f"Recovering {len(stuck)} stuck task(s)...")
for tid, product, branch, wt_path in stuck:
    wt = Path(wt_path)
    if not wt.exists():
        conn = sqlite3.connect(STATE_DB)
        conn.execute(
            "UPDATE tasks SET status='failed', error='worktree missing on recovery', finished_at=? WHERE id=?",
            (datetime.now(timezone.utc).isoformat(), tid),
        )
        conn.commit(); conn.close()
        print(f"  {tid}  {product:18s} FAILED (worktree gone)")
        continue
    porc = subprocess.run(
        ["git", "-C", str(wt), "status", "--porcelain"],
        capture_output=True, text=True,
    ).stdout.strip()
    if porc:
        subprocess.run(["git", "-C", str(wt), "add", "-A"], capture_output=True)
        subprocess.run(
            ["git", "-C", str(wt), "commit", "-m",
             f"Switch (recovered): {tid}\n\nProduct: {product}\nRecovered after orchestrator crash."],
            capture_output=True,
        )
        # Push if remote exists
        remotes = subprocess.run(["git", "-C", str(wt), "remote"], capture_output=True, text=True).stdout.strip()
        if remotes and branch:
            subprocess.run(
                ["git", "-C", str(wt), "push", "-u", "origin", branch],
                capture_output=True,
            )
    cost, tin, tout = parse_cost(LOGS_DIR / f"{tid}.log")
    status = "awaiting_approval" if porc else "no_changes"
    conn = sqlite3.connect(STATE_DB)
    conn.execute(
        "UPDATE tasks SET status=?, cost_usd=?, tokens_input=?, tokens_output=?, finished_at=? WHERE id=?",
        (status, cost, tin, tout, datetime.now(timezone.utc).isoformat(), tid),
    )
    conn.commit(); conn.close()
    print(f"  {tid}  {product:18s} -> {status:18s} ${cost:.4f}")

print("\nRecovery complete. Review in the dashboard or via `switch task list`.")
PY
